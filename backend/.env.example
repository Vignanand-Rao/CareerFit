# Server configuration
PORT=8000
ENVIRONMENT=development

# Database connection:
# Default is SQLite for instant zero-config local development
# To use PostgreSQL in production or local, set:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/careerfit
DATABASE_URL=sqlite:///./careerfit.db

# JWT Security
# Replace with a cryptographically secure key in production (min 32 characters)
JWT_SECRET=super-secret-careerfit-production-signing-key-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
